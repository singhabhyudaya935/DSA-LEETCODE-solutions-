class Solution {
public:
    int smallestDivisor(vector<int>& nums, int threshold) {
        int maxi=*max_element(nums.begin(),nums.end());
        int low=1;int high=maxi;
       while(low<=high){
        int mid=low+(high-low)/2;
            int sum=0;
            for(int num:nums){
                sum+=ceil((double)num/mid);
            } if(sum<=threshold){
             high=mid-1;
            } else{ low=mid+1;}
        } return low;}

        };
        
    
